# ZimaOS host directory that backs smb://192.168.68.93/Cameras/xiaomi_camera_videos.
# This is mounted read-only in the bridge container as /recordings.
XIAOMI_RECORDINGS_PATH=/DATA/Cameras/xiaomi_camera_videos

# Create .env from this file, then replace the publisher placeholder before startup.
# Generate secret values locally, for example:
#   openssl rand -base64 36
# Run secret-generation commands only in a private terminal; do not copy their
# output into shared logs, chat, or version control.
RTSP_PUBLISH_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PUBLISHER_PASSWORD

# The administrator is created in the browser on first launch. The app also
# generates and persists its own private session key under /data.
SETUP_COOKIE_SECURE=false

# Host addresses and published ports. 17883 avoids common web-service defaults.
# Changing a port is organization, not a security control; keep access LAN-only.
RTSP_BIND_ADDRESS=0.0.0.0
RTSP_PORT=8554
SETUP_BIND_ADDRESS=0.0.0.0
SETUP_UI_PORT=17883
